# Portfolio mode: the whole site runs on sample data inside your browser.
# No database or account needed. Copy this file to .env and run npm run dev.
PUBLIC_PORTFOLIO_MODE=true
PUBLIC_PORTFOLIO_REPO_URL=https://github.com/tgraharms/mytetamu-wedding-invite

# Optional: the deployed demo's own URL, used in link previews.
SITE_URL=

# Only if you turn portfolio mode off and connect your own Supabase project.
# Setting up a real database is not covered in this copy.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
LAB_PASSWORD=

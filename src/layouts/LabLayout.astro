---
/**
 * Shell for the /lab animation spike. Deliberately separate from Layout.astro
 * so nothing here can leak into the real invite. Every lab page is noindex.
 */
import '../styles/global.css';

interface Props {
  title: string;
  /** Short label shown in the sticky header, e.g. "Motion". */
  tag: string;
}

const { title, tag } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <title>{title} · Lab</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Great+Vibes&family=Mulish:wght@300;400;500;600;700&display=swap"
    />
    <!-- is:global — these classes are used by slotted page content, which does
         not carry this layout's scope hash, so scoped styles would never match. -->
    <style is:global>
      /* The lab pages scroll long; the real invite's fixed-height shell would
         fight ScrollTrigger, so use a plain full-width column here. */
      .lab-shell {
        max-width: 480px;
        margin-inline: auto;
        background: var(--dc-shell);
        min-height: 100vh;
      }
      .lab-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--dc-btn-text);
        background: rgba(40, 37, 32, 0.9);
        backdrop-filter: blur(6px);
      }
      .lab-bar a {
        color: var(--dc-gold-soft);
        text-decoration: none;
      }
      /* Live frame-timing readout — the whole point of the spike is measuring
         this on a throttled CPU, not eyeballing it. */
      .fps {
        font-variant-numeric: tabular-nums;
        display: flex;
        gap: 10px;
      }
      .fps b {
        font-weight: 700;
        color: #fff;
      }
      .fps-bad {
        color: #ff9d9d;
      }
      .lab-section {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 72px 24px;
      }
      .lab-eyebrow {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--dc-label);
      }
      .lab-h {
        font-family: 'Cormorant Garamond', serif;
        font-size: 40px;
        line-height: 1.1;
        color: var(--dc-ink-strong);
        margin-top: 10px;
      }
      .lab-p {
        margin-top: 14px;
        color: var(--dc-muted);
        line-height: 1.7;
        font-size: 15px;
      }
      .lab-card {
        border-radius: 18px;
        background: #fff;
        padding: 20px;
        box-shadow: 0 18px 40px -24px rgba(58, 54, 48, 0.55);
      }
      @media (prefers-reduced-motion: reduce) {
        .lab-note-rm {
          display: block !important;
        }
      }
    </style>
  </head>
  <body class="dc-body antialiased">
    <div class="lab-bar">
      <span><a href="/lab">← lab</a> · {tag}</span>
      <span class="fps">
        <span>fps <b id="fps-now">–</b></span>
        <span>worst <b id="fps-min">–</b></span>
        <span>jank <b id="fps-jank">–</b></span>
      </span>
    </div>

    <main class="lab-shell">
      <slot />
    </main>

    <script>
      // Rolling frame-timing meter. "jank" counts frames that took longer than
      // 50ms (~3 dropped frames at 60Hz) since page load — the number that
      // actually predicts how this feels on an older phone.
      let last = performance.now();
      let worst = Infinity;
      let jank = 0;
      let acc = 0;
      let frames = 0;
      const now = document.getElementById('fps-now');
      const min = document.getElementById('fps-min');
      const jk = document.getElementById('fps-jank');

      function tick(t: number) {
        const dt = t - last;
        last = t;
        if (dt > 0) {
          acc += dt;
          frames++;
          if (dt > 50) jank++;
          // Ignore the first few frames and tab-restore spikes.
          if (frames > 20 && dt < 2000) {
            const inst = 1000 / dt;
            if (inst < worst) worst = inst;
          }
          if (acc >= 500) {
            const fps = Math.round((frames * 1000) / acc);
            if (now) now.textContent = String(fps);
            if (min) min.textContent = worst === Infinity ? '–' : String(Math.round(worst));
            if (jk) {
              jk.textContent = String(jank);
              jk.parentElement?.classList.toggle('fps-bad', jank > 0);
            }
            acc = 0;
            frames = 0;
          }
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      // Expose for automated measurement from the harness.
      (window as any).__labStats = () => ({
        worst: worst === Infinity ? null : Math.round(worst),
        jank,
      });
      (window as any).__labReset = () => {
        worst = Infinity;
        jank = 0;
      };
    </script>
  </body>
</html>

---
import { site } from '../content/site';
import BackgroundImage from './BackgroundImage.astro';
import { PORTFOLIO } from '../lib/portfolio';

// Sasaran kira detik: tarikh + masa mula majlis dalam waktu Malaysia (+08:00).
const targetISO = `${site.event.dateISO}T${site.event.timeStart}:00+08:00`;
// Portfolio mode shows the site as guests saw it before the wedding: the
// wedding-day card never switches on, and the countdown runs to a date two
// weeks after the visit (set by the small script beside the countdown).
const navigationFrom = PORTFOLIO ? '9999-12-31T00:00:00+08:00' : '2026-09-18T00:00:00+08:00';
const navigationApps = [
  { name: 'Waze', href: site.venue.maps.waze, icon: '/icons/waze.svg', style: 'waze' },
  { name: 'Google Maps', href: site.venue.maps.googleMaps, icon: '/icons/google-maps.png', style: 'google' },
  { name: 'Apple Maps', href: site.venue.maps.appleMaps, icon: '/icons/apple-maps.svg', style: 'apple' },
];
const [startHour, startMinute] = site.event.timeStart.split(':').map(Number);
const displayStart = `${startHour % 12 || 12}:${String(startMinute).padStart(2, '0')} ${startHour >= 19 ? 'malam' : startHour >= 12 ? 'petang' : 'pagi'}`;
---

<section
  id="hero"
  data-navigation-from={navigationFrom}
  class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-8 text-center"
>
  <script is:inline>
    // Select the layout before the hero content is painted.
    (() => {
      const hero = document.getElementById('hero');
      if (hero) hero.dataset.navigation = String(Date.now() >= Date.parse(hero.dataset.navigationFrom));
    })();
  </script>
  {/* The only image on / that is above the fold, so the only one loaded
      eagerly at high priority. Its scrim keeps the hero's own gradient
      rather than Section's, and fades into the shell colour at the bottom. */}
  <BackgroundImage name="hero-bg" priority />
  <div class="hero-overlay absolute inset-0 z-[1]" aria-hidden="true"></div>

  <div class="hero-content relative z-[2] flex flex-col items-center">
    <p class="bismillah-arabic hero-in" lang="ar" dir="rtl" style="--d: 1.1s">
      <span class="sr-only">{site.hero.bismillah}</span>
      <span aria-hidden="true">﷽</span>
    </p>

    <p class="hero-in mt-6 max-w-[280px] text-[13px] leading-[1.85] text-stone-600" style="--d: 1.3s">
      {site.hero.salam}
    </p>

    <div class="hero-in mt-8" style="--d: 1.45s">
      <div class="dc-divider dc-divider--hero" aria-hidden="true"><span></span></div>
    </div>

    <h1 class="display-serif hero-in text-[42px] leading-[1.06]" style="--d: 1.6s">
      {site.couple.nama1}
    </h1>
    <div class="amp hero-in" style="--d: 1.7s">&amp;</div>
    <h1 class="display-serif hero-in text-[42px] leading-[1.06]" style="--d: 1.8s">
      {site.couple.nama2}
    </h1>

    <div class="hero-in mt-8 flex flex-col items-center gap-1.5" style="--d: 2s">
      <span class="text-sm font-bold uppercase tracking-[0.14em] text-[#4a453d]">
        {site.event.displayDate}
      </span>
      <span class="hero-venue text-[12.5px] tracking-[0.05em] text-[#7a746c]">
        {site.venue.name}, {site.venue.town}
      </span>
    </div>

    <div class="hero-event-panel hero-in" style="--d: 2.2s">
      <div class="hero-navigation">
        <p class="hero-navigation-label">Jumpa di sana</p>
        <p class="hero-navigation-title">{site.venue.name}</p>
        <p class="hero-navigation-subtitle">{site.venue.town} · {displayStart}</p>
        <nav class="hero-map-apps" aria-label="Navigasi ke lokasi majlis">
          {navigationApps.map((app) => (
            <a href={app.href} target="_blank" rel="noopener noreferrer" aria-label={`Buka ${app.name} ke ${site.venue.name}`}>
              <span class={`hero-map-icon hero-map-icon--${app.style}`}>
                <img src={app.icon} alt="" width="44" height="44" loading="lazy" />
              </span>
              <span>{app.name}</span>
            </a>
          ))}
        </nav>
      </div>
      <div
      id="countdown"
      class="hero-countdown"
      data-target={targetISO}
      aria-label="Kiraan detik ke majlis"
    >
      <span class="countdown-prefix">Lagi</span>
      <div class="cd-box"><div class="cd-num" data-cd="days">--</div><div class="cd-lbl">Hari</div></div>
      <div class="cd-box"><div class="cd-num" data-cd="hours">--</div><div class="cd-lbl">Jam</div></div>
      <div class="cd-box"><div class="cd-num" data-cd="mins">--</div><div class="cd-lbl">Minit</div></div>
      <div class="cd-box"><div class="cd-num" data-cd="secs">--</div><div class="cd-lbl">Saat</div></div>
    </div>{PORTFOLIO && (
      <script is:inline>
        document.getElementById('countdown')?.setAttribute('data-target', new Date(Date.now() + 14 * 864e5).toISOString());
      </script>
    )}
    </div>

    <div class="hero-in scroll-cue mt-10 flex flex-col items-center gap-1.5" style="--d: 2.5s" aria-hidden="true">
      <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#8a7a52]">Scroll</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-[#8a7a52]">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </div>
  </div>
</section>

<style>
  #hero[data-navigation='true'] { padding-top: 76px; padding-bottom: 24px; }
  .hero-event-panel { margin-top: 36px; }
  .hero-countdown { display: flex; justify-content: center; gap: 10px; }
  .hero-navigation, .countdown-prefix { display: none; }
  #hero[data-navigation='true'] .hero-venue { display: none; }
  #hero[data-navigation='true'] .hero-event-panel {
    width: min(352px, calc(100vw - 48px));
    margin-top: 20px;
    padding: 24px 14px 20px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 24px;
    background: rgba(255, 252, 246, 0.96);
    box-shadow: 0 12px 30px -20px rgba(70, 56, 32, 0.25);
    text-shadow: none;
  }
  #hero[data-navigation='true'] .hero-navigation { display: block; }
  .hero-navigation-label {
    margin: 0 0 14px;
    color: #806d48;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-navigation-title {
    margin: 0;
    color: #4a453d;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 29px;
    line-height: 1.15;
  }
  .hero-navigation-subtitle { margin: 5px 0 0; color: #7a6f59; font-size: 12px; }
  .hero-map-apps { display: flex; justify-content: space-around; gap: 6px; margin-top: 25px; }
  .hero-map-apps a {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    padding: 4px 0;
    color: #554c3e;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
  }
  .hero-map-apps a:focus-visible { outline: 2px solid #8a7450; outline-offset: 4px; border-radius: 10px; }
  .hero-map-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 5px 14px rgba(70, 56, 32, 0.1);
  }
  .hero-map-icon img { width: 29px; height: 29px; object-fit: contain; }
  .hero-map-icon--waze { background: #33ccff; }
  .hero-map-icon--apple img { width: 44px; height: 44px; }
  #hero[data-navigation='true'] .hero-countdown {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px solid #d8cdb7;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 3px 5px;
    color: #806d48;
    font-size: 12px;
  }
  #hero[data-navigation='true'] .countdown-prefix { display: inline; }
  #hero[data-navigation='true'] .cd-box {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    width: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  #hero[data-navigation='true'] .cd-box + .cd-box::before { content: '·'; margin-right: 2px; }
  #hero[data-navigation='true'] .cd-num { color: inherit; font-size: 23px; font-weight: 500; }
  #hero[data-navigation='true'] .cd-lbl {
    margin: 0;
    color: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: lowercase;
  }
  .bismillah-arabic {
    font-family: 'Amiri Quran', serif;
    color: #4a453d;
    /* Ligatur ﷽ sangat lebar (~11× saiz fon). Skalakan ikut lebar kad
       (kad dihadkan 480px) supaya sentiasa muat tanpa terpotong, dan tidak
       membesar keterlaluan pada skrin PC yang lebar. */
    font-size: min(6.8vw, 32px);
    line-height: 1.7;
    white-space: nowrap;
  }
  .display-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    letter-spacing: 0.015em;
    color: #3b362f;
    margin: 0;
  }
  .amp {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 26px;
    color: #b49a6a;
    margin: 8px 0 4px;
  }

  /* Pembahagi versi hero — lebih panjang, berlian bercincin. */
  .dc-divider--hero {
    gap: 12px;
    margin: 0;
  }
  .dc-divider--hero::before,
  .dc-divider--hero::after {
    width: 46px;
  }
  .dc-divider--hero > span {
    width: 7px;
    height: 7px;
    box-shadow: 0 0 0 3px rgba(180, 154, 106, 0.16);
  }

  /* Kotak kira detik berfrost. */
  .cd-box {
    width: 64px;
    padding: 12px 4px 10px;
    border-radius: 16px;
    background: rgba(255, 254, 251, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      0 14px 30px -18px rgba(60, 50, 35, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    text-align: center;
  }
  .cd-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    font-size: 30px;
    line-height: 1;
    color: #3b362f;
  }
  .cd-lbl {
    margin-top: 5px;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a08f74;
    font-weight: 700;
  }

  /* Hero crops from the top: the couple's faces sit in the upper third,
     and a centred crop cuts them off on a tall phone. */
  #hero :global(.bgimg img) {
    object-position: center top;
  }
  /* BackgroundImage always renders a .bgimg-scrim, but the hero already has
     its own overlay div below (same gradient, animated fade-in). Neutralise
     the scrim here so the two don't stack into a doubled, over-whitened
     wash — .hero-overlay is the only visible gradient on the hero. */
  #hero :global(.bgimg-scrim) {
    background-image: none;
  }
  /* Imej hero kelihatan serta-merta; overlay & teks masuk beransur-ansur. */
  .hero-overlay {
    /* Tudung putih hampir sekata supaya teks mudah dibaca merentas hero,
       kemudian lebur ke krim kad di bahagian bawah. */
    background-image: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.58) 0%,
      rgba(255, 255, 255, 0.68) 22%,
      rgba(255, 255, 255, 0.7) 48%,
      rgba(253, 250, 244, 0.82) 78%,
      #f7f3ec 100%
    );
    animation: hero-overlay-in 1s ease 0.75s both;
  }
  .hero-content {
    /* Halo putih kuat di belakang setiap teks — copywriting kekal jelas
       walaupun latar taman sibuk (rujukan: gaya mytetamu.my). */
    text-shadow:
      0 0 14px rgba(255, 255, 255, 0.95),
      0 0 6px rgba(255, 255, 255, 0.92),
      0 1px 2px rgba(255, 255, 255, 0.9);
  }
  .hero-in {
    animation: hero-in 0.7s ease var(--d, 0s) both;
  }
  .scroll-cue {
    animation:
      hero-in 0.7s ease var(--d, 0s) both,
      floaty 2.6s ease-in-out 3.2s infinite;
  }

  @keyframes hero-overlay-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(7px);
    }
  }

  /* Hormati keutamaan kurang-gerak: papar terus tanpa animasi. */
  @media (prefers-reduced-motion: reduce) {
    .hero-overlay,
    .hero-in,
    .scroll-cue {
      animation: none;
    }
  }
</style>

<script>
  // Kira detik langsung ke saat majlis bermula (waktu Malaysia).
  const root = document.getElementById('countdown');
  const hero = document.getElementById('hero');
  if (root) {
    const target = new Date(root.dataset.target!).getTime();
    const fields = {
      days: root.querySelector('[data-cd="days"]')!,
      hours: root.querySelector('[data-cd="hours"]')!,
      mins: root.querySelector('[data-cd="mins"]')!,
      secs: root.querySelector('[data-cd="secs"]')!,
    };
    const pad = (n: number) => String(n).padStart(2, '0');

    function tick() {
      const now = Date.now();
      if (hero) hero.dataset.navigation = String(now >= Date.parse(hero.dataset.navigationFrom!));
      const diff = Math.max(0, target - now);
      fields.days.textContent = pad(Math.floor(diff / 86400000));
      fields.hours.textContent = pad(Math.floor((diff % 86400000) / 3600000));
      fields.mins.textContent = pad(Math.floor((diff % 3600000) / 60000));
      fields.secs.textContent = pad(Math.floor((diff % 60000) / 1000));
    }

    // Only tick while the tab is visible. A wedding countdown does not need
    // to keep four DOM writes a second running in a backgrounded tab on
    // someone's phone.
    let timer: number | undefined;
    function startTicking(): void {
      if (timer !== undefined) return;
      tick();
      timer = window.setInterval(tick, 1000);
    }
    function stopTicking(): void {
      if (timer === undefined) return;
      clearInterval(timer);
      timer = undefined;
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopTicking();
      else startTicking();
    });
    startTicking();
  }
</script>

---
/**
 * Full-bleed background layer: AVIF with a JPEG fallback, behind a scrim.
 *
 * These used to be CSS `background-image`, which cannot carry
 * `fetchpriority` or `loading="lazy"`. Both matter here — the hero was
 * competing on equal terms with five below-the-fold images and losing.
 *
 * `image-set()` would have kept them in CSS, but Safari 16 and earlier drop
 * the whole declaration when it contains `type()`, leaving those phones with
 * no background at all. `<picture>` degrades correctly everywhere.
 */
import manifest from '../../public/bg/manifest.json';

interface Props {
  /** Key in public/bg/manifest.json. */
  name: keyof typeof manifest;
  /** Above the fold: load eagerly at high priority. */
  priority?: boolean;
  /** Scrim opacity — how strongly the artwork is muted behind the content. */
  band?: number;
}

const { name, priority = false, band = 0.72 } = Astro.props;
const art = manifest[name];
if (!art) throw new Error(`BackgroundImage: "${name}" is not in public/bg/manifest.json`);
---

<div class="bgimg" aria-hidden="true">
  <picture>
    <source srcset={art.avif} type="image/avif" />
    <img
      src={art.jpg}
      alt=""
      width={art.width}
      height={art.height}
      decoding="async"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'low'}
    />
  </picture>
  <div class="bgimg-scrim" style={`--band: ${band}`}></div>
</div>

<style>
  .bgimg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .bgimg img {
    width: 100%;
    height: 100%;
    /* Matches the `background-size: cover; background-position: center` these
       layers replaced. The hero's `center top` is overridden by its caller. */
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Was the first layer of the old two-layer `background-image`. Splitting it
     out is forced by moving the artwork into an <img>; the gradient stops are
     copied verbatim so the rendered result is unchanged. */
  .bgimg-scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      #f7f3ec 0%,
      rgba(247, 243, 236, var(--band)) 18%,
      rgba(247, 243, 236, var(--band)) 82%,
      #f7f3ec 100%
    );
  }
</style>
